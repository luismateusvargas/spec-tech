{
  "_comment": "REFERENCE FILE — replace [NPM_GLOBAL], [PYTHON_SCRIPTS], and [CAVEMAN_PLUGIN] with actual paths on your system. On Linux/macOS, use 'cavemem' directly if in PATH.",
  "permissions": {
    "deny": []
  },
  "model": "claude-sonnet-5",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[NPM_GLOBAL]/node_modules/cavemem/dist/index.js hook run user-prompt-submit --ide claude-code"
          },
          {
            "type": "command",
            "command": "bash -c \"node '$HOME/.claude/hooks/inject-handoff.cjs'\""
          },
          {
            "type": "command",
            "command": "bash -c \"node '$HOME/.claude/hooks/clarify-ambiguity.cjs'\""
          },
          {
            "type": "command",
            "command": "bash -c \"node '$HOME/.claude/hooks/enforce-prompt-structure.cjs'\""
          },
          {
            "type": "command",
            "command": "bash -c \"node '$HOME/.claude/hooks/inject-known-corrections.cjs'\""
          },
          {
            "type": "command",
            "command": "bash -c \"node '$HOME/.claude/hooks/capture-cardinal-rules.cjs'\""
          },
          {
            "type": "command",
            "command": "bash -c \"node '$HOME/.claude/hooks/inject-sdd-guard.cjs'\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c \"node '$HOME/.claude/hooks/block-attribution-commit.cjs'\""
          },
          {
            "type": "command",
            "command": "bash -c \"node '$HOME/.claude/hooks/redirect-bash-to-tools.cjs'\""
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c \"node '$HOME/.claude/hooks/enforce-read-pagination.cjs'\""
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c \"node '$HOME/.claude/hooks/block-security-violations.cjs'\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[NPM_GLOBAL]/node_modules/cavemem/dist/index.js hook run post-tool-use --ide claude-code"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c \"node '$HOME/.claude/hooks/catch-command-errors.cjs'\""
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c \"node '$HOME/.claude/hooks/remind-spec-drift.cjs'\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/handoff-precompact.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[NPM_GLOBAL]/node_modules/cavemem/dist/index.js hook run session-start --ide claude-code"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[NPM_GLOBAL]/node_modules/cavemem/dist/index.js hook run stop --ide claude-code"
          },
          {
            "type": "command",
            "command": "bash -c \"node '$HOME/.claude/hooks/stop-handoff.cjs'\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[NPM_GLOBAL]/node_modules/cavemem/dist/index.js hook run session-end --ide claude-code"
          }
        ]
      }
    ]
  },
  "theme": "dark",
  "mcpServers": {
    "cavemem": {
      "command": "node",
      "args": [
        "$HOME/.claude/plugins/cache/caveman/caveman/[VERSION]/src/mcp-servers/caveman-shrink/index.js",
        "node",
        "[NPM_GLOBAL]/node_modules/cavemem/dist/index.js",
        "mcp"
      ]
    },
    "graphify": {
      "command": "node",
      "args": [
        "$HOME/.claude/plugins/cache/caveman/caveman/[VERSION]/src/mcp-servers/caveman-shrink/index.js",
        "[PYTHON_SCRIPTS]/graphify-mcp-server"
      ]
    }
  },
  "skipWorkflowUsageWarning": true
}
